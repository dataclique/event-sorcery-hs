cabal-version:      3.0
name:               event-sorcery
version:            0.1.0.0
synopsis:           Type-driven event sourcing
description:
  Pure, type-driven event-sourcing primitives with in-memory and SQLite
  persistence.

homepage:           https://github.com/dataclique/event-sorcery-hs
bug-reports:        https://github.com/dataclique/event-sorcery-hs/issues
license:            MIT
license-file:       LICENSE
build-type:         Simple
category:           Database
extra-source-files:
  adrs/*.md
  fourmolu.yaml
  README.md
  stack.yaml
  stack.yaml.lock

common strict
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    GADTs
    LinearTypes
    MultiParamTypeClasses
    MultilineStrings
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    RankNTypes
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeFamilyDependencies
    UndecidableInstances

  ghc-options:
    -Wall -Wcompat -Werror -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists
    -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
  import:          strict
  exposed-modules:
    EventSorcery
    EventSorcery.Aggregate
    EventSorcery.Backend.Memory
    EventSorcery.Backend.SQLite
    EventSorcery.Projection
    EventSorcery.Store
    EventSorcery.Stream

  other-modules:
    EventSorcery.Projection.Internal
    EventSorcery.Store.Internal

  hs-source-dirs:  src
  build-depends:
    , base           >=4.18  && <5
    , bytestring     >=0.11  && <0.13
    , conduit        >=1.3.6 && <1.4
    , containers     >=0.6   && <0.9
    , protolude      >=0.3.4 && <0.4
    , sqlite-simple  >=0.4   && <0.5
    , stm            >=2.5   && <2.6
    , text           >=2.0   && <2.2

test-suite event-sorcery-test
  import:         strict
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: test
  build-depends:
    , aeson          >=2.2   && <2.3
    , base           >=4.18  && <5
    , bytestring     >=0.11  && <0.13
    , conduit        >=1.3.6 && <1.4
    , event-sorcery
    , hspec          >=2.11  && <2.12
    , protolude      >=0.3.4 && <0.4
    , text           >=2.0   && <2.2

benchmark event-sorcery-benchmark
  import:         strict
  type:           exitcode-stdio-1.0
  main-is:        Bench.hs
  hs-source-dirs: benchmark
  ghc-options:    -O2 -rtsopts
  build-depends:
    , aeson          >=2.2   && <2.3
    , base           >=4.18  && <5
    , bytestring     >=0.11  && <0.13
    , conduit        >=1.3.6 && <1.4
    , criterion      >=1.6.4 && <1.7
    , event-sorcery
    , protolude      >=0.3.4 && <0.4
    , text           >=2.0   && <2.2
