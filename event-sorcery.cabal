cabal-version:      3.0
name:               event-sorcery
version:            0.1.0.0
synopsis:           Type-driven event sourcing
description:
  Pure, type-driven event-sourcing primitives with in-memory and SQLite
  persistence.

homepage:           https://github.com/dataclique/event-sorcery-hs
bug-reports:        https://github.com/dataclique/event-sorcery-hs/issues
license:            MIT
license-file:       LICENSE
build-type:         Simple
category:           Database
extra-source-files:
  adrs/*.md
  fourmolu.yaml
  README.md

common strict
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    GADTs
    MultiParamTypeClasses
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeFamilyDependencies
    UndecidableInstances

  ghc-options:
    -Wall -Wcompat -Werror -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists
    -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
  import:          strict
  exposed-modules:
    EventSorcery
    EventSorcery.Aggregate
    EventSorcery.Stream

  hs-source-dirs:  src
  build-depends:
    , base        >=4.18  && <5
    , bytestring  >=0.11  && <0.13
    , protolude   >=0.3.4 && <0.4
    , text        >=2.0   && <2.2

test-suite event-sorcery-test
  import:         strict
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: test
  build-depends:
    , aeson          >=2.2   && <2.3
    , base           >=4.18  && <5
    , bytestring     >=0.11  && <0.13
    , event-sorcery
    , hspec          >=2.11  && <2.12
    , protolude      >=0.3.4 && <0.4
    , text           >=2.0   && <2.2
